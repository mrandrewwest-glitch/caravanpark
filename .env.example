# Leave ANTHROPIC_API_KEY empty to run with the offline stub Claude client.
ANTHROPIC_API_KEY=
# "auto" (live if key set, else stub) | "live" | "stub"
CLAUDE_MODE=auto
EXTRACTION_MODEL=claude-haiku-4-5-20251001
RESPONSE_MODEL=claude-sonnet-5-5

PORT=3000
PARK_ID=friend-caravan-park
# Set to "false" to disable POST /test-call (disabled automatically when NODE_ENV=production)
ENABLE_TEST_ENDPOINT=true
# Hard per-turn budget in ms (Dialpad will not tolerate more than ~3s)
TURN_DEADLINE_MS=2800
LOG_LEVEL=info

# Lambda only: fetch ANTHROPIC_API_KEY from Secrets Manager at cold start
# ANTHROPIC_SECRET_ARN=arn:aws:secretsmanager:...
